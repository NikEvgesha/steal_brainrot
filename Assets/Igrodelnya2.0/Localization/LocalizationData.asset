  - Key: UI/Tutorial/Step/buy_first_egg/Touch
    Translations:
    - "\u041A\u0443\u043F\u0438 \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u0435
      \u044F\u0439\u0446\u043E \u0437\u0430 {0} \u043C\u043E\u043D\u0435\u0442."
